log_format contas_safe '$remote_addr $request_method $uri $status $request_time';

server {
    access_log /var/log/nginx/access.log contas_safe;
    listen 80;
    server_name _;
    resolver 127.0.0.11 valid=10s ipv6=off;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    location ~ ^/auth/(realms|resources|admin)(/|$) {
        set $identity keycloak:8080;
        proxy_pass http://$identity;
    }

    location ~ ^/(api|openapi|scalar)(/|$) {
        set $backend ${CONTAS_DEBUG_HOST}:5080;
        proxy_pass http://$backend;
    }

    location = /health {
        set $backend ${CONTAS_DEBUG_HOST}:5080;
        proxy_pass http://$backend;
    }

    location / {
        set $frontend ${CONTAS_DEBUG_HOST}:3000;
        proxy_pass http://$frontend;
    }
}
